# PostgreSQL — auth-service (:5436)
POSTGRES_AUTH_URL=jdbc:postgresql://localhost:5436/auth_db
POSTGRES_AUTH_USER=
POSTGRES_AUTH_PASSWORD=

# JWT (RS256) — auth-service signs, every other service validates via JWKS
# Base64 PKCS#8 DER RSA private key. Leave empty in local dev to get an ephemeral key (tokens die on restart).
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
JWT_PRIVATE_KEY=
JWT_ISSUER=fraudshield-auth-service
JWT_EXPIRATION_MS=900000
AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json

# Service-to-service credentials (account-service -> auth-service /auth/users/lookup)
# Generate: openssl rand -base64 32
SERVICE_CLIENT_ACCOUNT_SECRET=

# Refresh token
REFRESH_TOKEN_EXPIRATION_MS=604800000

# PostgreSQL — account-service (:5432)
POSTGRES_ACCOUNT_URL=jdbc:postgresql://localhost:5442/account_db
POSTGRES_ACCOUNT_USER=
POSTGRES_ACCOUNT_PASSWORD=

# PostgreSQL — transaction-service (:5443)
POSTGRES_TRANSACTION_URL=jdbc:postgresql://localhost:5443/transaction_db
POSTGRES_TRANSACTION_USER=
POSTGRES_TRANSACTION_PASSWORD=

# PostgreSQL — fraud-detection-service (:5434)
POSTGRES_FRAUD_URL=jdbc:postgresql://localhost:5434/fraud_db
POSTGRES_FRAUD_USER=
POSTGRES_FRAUD_PASSWORD=

# MongoDB — ledger-service (:27017)
MONGO_LEDGER_HOST=localhost
MONGO_LEDGER_PORT=27017
MONGO_LEDGER_DB=ledger_db
MONGO_LEDGER_USER=
MONGO_LEDGER_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Observability — OTLP traces go to the local otel-collector (services run on the host, collector runs in Docker)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
